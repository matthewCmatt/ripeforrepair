---
import Layout from "../../components/Layout.astro";
import { pb } from "../../lib/pb";

const events = await pb.collection("events").getFullList();
---

<Layout>
    <ol>
        {
            events.map((e) => (
                <a href={`/events/${e.url}`}>
                    <li>
                        Event
                        {e.starttime}
                    </li>
                </a>
            ))
        }
    </ol>
</Layout>
