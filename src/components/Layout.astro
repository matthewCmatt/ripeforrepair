---
import "../styles/reset.css";
import "../styles/global.css";
import { readSingleton } from "@directus/sdk";
import { directus, type About } from "../lib/directus";

const { title, description } = Astro.props;

const about: About = await directus.request(readSingleton("about"));
---

<html lang="en">
    <head>
        <meta charset="utf-8" />
        <link rel="icon" type="image/jpeg" href="/favicon.svg" />
        <meta name="viewport" content="width=device-width" />
        <meta name="generator" content={Astro.generator} />
        <meta name="description" content={description} />
        <link rel="sitemap" href="/sitemap-index.xml" />
        <title>
            {title ? `${title} - ${about.page_title}` : about.page_title}
        </title>
    </head>
    <body>
        <header>
            <a href="/">
                <h1>{about.page_title}</h1>
            </a>
        </header>
        <main>
            <slot />
        </main>
    </body>
</html>

<style>
    body {
        padding: 1em;
        max-width: 80ch;
        margin: auto;
        background-color: var(--color-green);
    }

    h1 {
        text-align: center;
        padding: 0.5em 0;
        font-weight: 400;
        letter-spacing: -1px;
    }

    section {
        display: flex;
        flex-direction: column;
        gap: 1em;
        padding-top: 2em;
    }

    .side-by-side {
        display: grid;

        p {
            font-size: 1.2em;
            margin: auto;
        }
    }

    @media (width > 700px) {
        .side-by-side {
            grid-template-columns: 1fr 1fr;
        }
    }

    header > a {
        color: inherit;
        text-decoration: none;
    }
</style>
