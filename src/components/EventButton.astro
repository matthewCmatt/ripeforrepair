---
    import { formatTime12Hour, formatDate } from "../lib/format";
    const { event, isPast } = Astro.props;
---

<a href={`/events/${event.id}`}>
    <li>
        <h3>{event.name}</h3>

        <p class="meta">
            <span>{formatDate(event.date)}</span>
            <span>
                {formatTime12Hour(event.start_time)} -{" "}
                {formatTime12Hour(event.end_time)}
            </span>
            <span>{event.address}</span>
        </p>
    </li>
</a>

<style>
    h2 {
        margin-top: 2.5rem;
        margin-bottom: 1rem;
        font-size: 1.6rem;
        border-bottom: 2px solid #eee;
        padding-bottom: 0.5rem;
    }

    ol {
        list-style: none;
        padding: 0;
        margin: 0;
        display: grid;
        gap: 1rem;
    }

    a:has(li) {
        background: white;
        border: 1px solid #e5e7eb;
        border-radius: 10px;
        transition:
            transform 0.15s ease,
            box-shadow 0.15s ease;
    }

    a:has(li) {
        display: block;
        padding: 1.25rem 1.5rem;
        text-decoration: none;
        color: inherit;
    }

    a:has(li):hover {
        transform: translateY(-2px);
        box-shadow: 0 6px 18px rgba(0, 0, 0, 0.08);
    }

    a:has(li) h3 {
        margin: 0 0 0.4rem;
        font-size: 1.2rem;
        font-weight: 600;
    }

    .meta {
        display: flex;
        flex-wrap: wrap;
        gap: 0.75rem;
        font-size: 0.9rem;
        color: #555;
    }

    .meta span::before {
        content: "•";
        margin-right: 0.5rem;
        color: #aaa;
    }

    .meta span:first-child::before {
        content: "";
        margin: 0;
    }

    /* Past events look muted */
    a:has(li).past {
        opacity: 0.7;
        background: #fafafa;
    }
</style>
