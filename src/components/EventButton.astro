---
import { formatTime12Hour, formatDate, slugify } from "../lib/format";

import { type Event } from "../lib/directus";

interface Props {
    event: Event;
}
const { event } = Astro.props;
---

<a
    href={`/events/${slugify(event.date.toLocaleString())}/`}
    class="link-button event"
>
    <h3>{event.name}</h3>

    <p>{formatDate(event.date)}</p>
    <p>
        {formatTime12Hour(event.start_time)} -{" "}
        {formatTime12Hour(event.end_time)}
    </p>
    <p>{event.address}</p>

    {event.status == "cancelled" && <div class="corner-sticker">CANCELLED</div>}
</a>

<style>
    a {
        position: relative;
    }

    a h3 {
        margin: 0 0 0.4rem;
        font-size: 1.2rem;
        font-weight: 600;
    }

    a p {
        font-size: 0.9rem;
        color: #555;
    }

    .corner-sticker {
        background-color: red;
        color: white;
        padding: 0.25em 0.5em 0em;
        position: absolute;
        top: 0;
        right: 0;
        transform: rotate(10deg) translate(10px, -10px);
        text-box-trim: trim-both;
    }
</style>
