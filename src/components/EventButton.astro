---
    import { formatTime12Hour, formatDate } from "../lib/format";
    const { event, isPast } = Astro.props;
---

    <li>
<a href={`/events/${event.id}/`}>
        <h3>{event.name}</h3>

        <p class="meta">
            <span>{formatDate(event.date)}</span>
            <span>
                {formatTime12Hour(event.start_time)} -{" "}
                {formatTime12Hour(event.end_time)}
            </span>
            <span>{event.address}</span>
        </p>
</a>
    </li>

<style>
    a {
        background: white;
        border: 1px solid #e5e7eb;
        border-radius: 10px;
        transition:
            transform 0.15s ease,
            box-shadow 0.15s ease;
    }

    a {
        display: block;
        padding: 1.25rem 1.5rem;
        text-decoration: none;
        color: inherit;
    }

    a:hover {
        transform: translateY(-2px);
        box-shadow: 0 6px 18px rgba(0, 0, 0, 0.08);
    }

    a h3 {
        margin: 0 0 0.4rem;
        font-size: 1.2rem;
        font-weight: 600;
    }

    .meta {
        display: flex;
        flex-wrap: wrap;
        gap: 0.75rem;
        font-size: 0.9rem;
        color: #555;
    }

    .meta span::before {
        content: "•";
        margin-right: 0.5rem;
        color: #aaa;
    }

    .meta span:first-child::before {
        content: "";
        margin: 0;
    }

    /* Past events look muted */
    a.past {
        opacity: 0.7;
        background: #fafafa;
    }
</style>
