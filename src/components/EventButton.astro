---
import { formatTime12Hour, formatDate, slugify } from "../lib/format";

import { type Event } from "../lib/directus"

interface Props {
    event: Event
}
const { event } = Astro.props;
---
    <a href={`/events/${slugify(event.date.toLocaleString())}/`} class="link-button event">
        <h3>{event.name}</h3>

        <p class="meta">
            <span>{formatDate(event.date)}</span>
            <span>
                {formatTime12Hour(event.start_time)} -{" "}
                {formatTime12Hour(event.end_time)}
            </span>
            <span>{event.address}</span>
        </p>
    </a>

<style>
    a h3 {
        margin: 0 0 0.4rem;
        font-size: 1.2rem;
        font-weight: 600;
    }

    .meta {
        display: flex;
        flex-wrap: wrap;
        gap: 0.75rem;
        font-size: 0.9rem;
        color: #555;
    }

    .meta span::before {
        content: "•";
        margin-right: 0.5rem;
        color: #aaa;
    }

    .meta span:first-child::before {
        content: "";
        margin: 0;
    }
</style>
