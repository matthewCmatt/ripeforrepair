---
import Layout from "../../components/Layout.astro";
import { directus } from "../../lib/directus"
import { readItems } from '@directus/sdk';
import { formatTime12Hour, formatDate, slugify } from "../../lib/format";

export async function getStaticPaths() {
    const events = await directus.request(readItems('events'));
    return events.map((r) => {
        return { params: { event: slugify(r.date.toLocaleString()) }, props: { content: r } };
    });
}

const e = Astro.props.content;

import { ICalendar, type CalendarOptions, GoogleCalendar, YahooCalendar, OutlookCalendar } from 'datebook'

const calendarOptions: CalendarOptions = {
  title: e.name,
  location: e.address,
  description: 'Ripe for Repair meetup',
  start: new Date(`${e.date}T${e.start_time}`),
  end: new Date(`${e.date}T${e.end_time}`),
}

const icsFile = new ICalendar(calendarOptions).render();
const googleCalendar = new GoogleCalendar(calendarOptions).setParam('src', 'admin@ripe4repair.org').render();
const yahooCalendar = new YahooCalendar(calendarOptions).render();
const outlookCalendar = new OutlookCalendar(calendarOptions).setParam('online', 'false').render();
---

<Layout title={e.name} description=`A Ripe for Repair meetup on ${formatDate(e.date)}`>
    <h2>
        {e.name}
    </h2>

    <p>
        {formatDate(e.date)}
    </p>

    <p>
        {`${formatTime12Hour(e.start_time)} - ${formatTime12Hour(e.end_time)}`}
    </p>
    
    <p>{e.address}</p>

    <div set:html={e.description}></div>

    {e.repairs_available ? <>
    <br/>
    <h3>Repairs Available:</h3>
    <ul class="repairs">
        {e.repairs_available?.map((repair) => 
            <li>
                {repair}
            </li>
        )}
    </ul></>
    : <></>}
<!-- 
    <br/>

    <h3>Add to your calendar</h3>
    <a href={googleCalendar} target="_blank" rel="noopener">
    Google Calendar
    </a>
    <br/>
    <a href={outlookCalendar} target="_blank" rel="noopener">
    Outlook Web
    </a>
    <br/>
    <a href={yahooCalendar} target="_blank" rel="noopener">
    Yahoo Calendar
    </a> -->
</Layout>

<style>
    ul {
        display: flex;
        flex-wrap: wrap;
        gap: 1ch;
    }
    li {
        display: inline-block;
        background-color: var(--color-yellow);
        padding: 8px;
        border-radius: 8px;
        line-height: 0.8em;
        padding-bottom: 5px;
    }
    p {
        margin-bottom: 1em;
    }
</style>