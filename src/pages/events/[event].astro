---
import Layout from "../../components/Layout.astro";
import { directus } from "../../lib/directus"
import { readItems } from '@directus/sdk';

export async function getStaticPaths() {
    const events = await directus.request(readItems('events'));
    return events.map((r) => {
        return { params: { event: r.id }, props: { content: r } };
    });
}

const e = Astro.props.content;

console.log(e)
---

<Layout title={e.name}>
    <h2>
        {e.name}
    </h2>

    <div>{e.start_time}</div>

    <div>{e.address}</div>

    <br/>

    <div set:html={e.description}></div>

    {e.repairs_available.length != 0 ?
    <br/>
    <h3>Repairs Available:</h3>
    <ul>
        {e.repairs_available.map((repair) => 
            <li>
                {repair}
            </li>
        )}
    </ul>
    : <></>}

</Layout>

<style>
    ul {
        display: flex;
        flex-wrap: wrap;
        gap: 1ch;
    }
    li {
        display: inline-block;
        background-color: var(--color-yellow);
        padding: 8px;
        border-radius: 8px;
        line-height: 0.8em;
        padding-bottom: 5px;
    }
</style>