---
import Layout from "../../components/Layout.astro";
import { directus } from "../../lib/directus"
import { readItems } from '@directus/sdk';

const events = await directus.request(readItems('events'));
---

<Layout title="Events">
    <ol>
        {
            events.map((e) => (
                <a href={`/events/${e.id}`}>
                    <li>
                        Event {e.name}
                        {e.start_time}
                        {e.address}
                    </li>
                </a>
            ))
        }
    </ol>
</Layout>
