---
import Layout from "../../components/Layout.astro";
import { directus } from "../../lib/directus";
import { readItems } from "@directus/sdk";
import { formatTime12Hour, formatDate } from "../../lib/format";
import EventButton from "../../components/EventButton.astro";

const now = new Date().toISOString();
const upcomingEvents = await directus.request(
    readItems("events", {
        filter: {
            date: { _gte: now } as any,
        },
        sort: ["date"],
    }),
);

const pastEvents = await directus.request(
    readItems("events", {
        filter: {
            date: { _lt: now } as any,
        },
        sort: ["-date"],
    }),
);
---

<Layout
    title="Events"
    description="All of the Ripe for Repair events, upcoming and past"
>
    <h2>Upcoming Events</h2>
    <ol>
        { upcomingEvents.length != 0 ?
            (upcomingEvents.map((e) => (
                <li>
                    <EventButton event={e} />
                </li>
            )))
            : (
                "We haven't posted the next event yet. Stay tuned!"
            )
        }
    </ol>

    <h2>Past Events</h2>
    <ol>
        {
            pastEvents.map((e) => (
                <li>
                    <EventButton event={e} />
                </li>
            ))
        }
    </ol>
</Layout>

<style>
    h2 {
        margin-top: 2.5rem;
        margin-bottom: 1rem;
        font-size: 1.6rem;
        border-bottom: 2px solid #eee;
        padding-bottom: 0.5rem;
    }

    ol {
        list-style: none;
        padding: 0;
        margin: 0;
        display: grid;
        gap: 1rem;
    }
</style>
