---
import EventButton from "../components/EventButton.astro";
import Layout from "../components/Layout.astro";
import { directus } from "../lib/directus";
import { readItems } from "@directus/sdk";
import { formatDate } from "../lib/format";

const now = new Date().toISOString();

const nextEvent = (
    await directus.request(
        readItems("events", {
            filter: {
                date: { _gte: now } as any,
            },
            sort: ["date"],
            limit: 1,
        }),
    )
)[0];
---

<Layout
    description=`Repair meetups in Portland, Maine, USA. The next event is ${formatDate(nextEvent.date)}`
>
    <div>
        <h2>Repair meetups in Portland, Maine</h2>
    </div>
    <section class="side-by-side">
        <p>
            A semi-regular hang to fix our broken things, learn new skills,
            teach each other stuff, and build community across social circles.
            Free & open to all.
        </p>
        <div class="meetup">
            <h3>Come to the next meetup!</h3>
            <EventButton event={nextEvent} />
            <a href="/events/" class="link-button event"> View all events </a>
        </div>
    </section>
    <section>
        <a href="/signup/" class="email link-button">
            Sign up for emails!
        </a>
    </section>
    <section class="link-group">
        <a
            href="https://www.instagram.com/ripe_for_repair/"
            class="link-button socials"
        >
            Instagram
        </a>
        <a
            href="https://www.facebook.com/p/Ripe-for-Repair-61556538260758/"
            class="link-button socials"
        >
            Facebook
        </a>
    </section>
    <section class="news">
        <h3>In the news</h3>
        <a
            href="https://www.pressherald.com/2024/12/09/portland-repair-meetups-mend-items-knit-community/"
        >
            In The Forecaster: "Portland Repair Meetups mend items, knit
            community"
        </a>
        <br/>
        <a
            href="https://wgme.com/news/local/mainers-unite-to-fix-items-and-build-skills-at-ripe-to-repair-event-in-portland"
        >
            On TV (WGME): "Mainers unite to fix items and build skills at Ripe
            to Repair event in Portland"
        </a>
    </section>
</Layout>

<style>
    .meetup {
        display: flex;
        flex-direction: column;
        gap: 1em;
        padding-top: 2em;
    }

    .side-by-side {
        display: grid;

        p {
            font-size: 1.2em;
            margin: auto;
        }
    }

    @media (width > 700px) {
        .side-by-side {
            grid-template-columns: 1fr 1fr;
        }
    }

    section {
        &:not(:last-child) {
            padding-bottom: 2em;
        }

        &:not(:first-child) {
            padding-top: 1em;
        }
    }

    h2 {
        text-align: center;
    }

    .link-group {
        display: grid;
        grid-template-columns: 1fr 1fr;
        justify-content: center;
        gap: 1ch;
    }

    .email {
        --color-bg: var(--color-orange);
    }

    .socials {
        --color-bg: var(--color-mauve);
    }

    .news {
        h3 {
            margin-bottom: 1em;
        }
    }
</style>
