---
import EventButton from "../components/EventButton.astro";
import Layout from "../components/Layout.astro";
import { directus, type About, type NewsCoverage, type Resource } from "../lib/directus";
import { readItems, readSingleton } from "@directus/sdk";
import { formatDate } from "../lib/format";
import Facebook from "../components/icons/Facebook.astro";
import Instagram from "../components/icons/Instagram.astro";

const now = new Date().toISOString();

const about: About = await directus.request(readSingleton("about"));

const nextEvent = (
    await directus.request(
        readItems("events", {
            filter: {
                date: { _gte: now } as any,
            },
            sort: ["date"],
            limit: 1,
        }),
    )
)[0];
---

<Layout
    description=`${about.page_subtitle}. The next event is ${formatDate(nextEvent.date)}`
>
    <div>
        <h2>{about.page_subtitle}</h2>
    </div>
    <section class="side-by-side">
        <p>
            {about.page_details}
        </p>
        <div class="meetup">
            <h3>Come to the next meetup!</h3>
            <EventButton event={nextEvent} />
            <a href="/events/" class="link-button event"> View all events </a>
        </div>
    </section>
    <section>
        <a href="/signup/" class="email link-button">
            Sign up for emails!
        </a>
    </section>
    <section class="link-group">
        <a
            href="https://www.instagram.com/ripe_for_repair/"
            class="link-button socials"
        >
            <Instagram/>
            Instagram
        </a>
        <a
            href="https://www.facebook.com/p/Ripe-for-Repair-61556538260758/"
            class="link-button socials"
        >
            <Facebook/>
            Facebook
        </a>
    </section>
    <section class="resources">
        <h3>Resources</h3>
        {about.resources.map((r: Resource) => (
            <a href={r.href}>
                {r.title}
            </a>
            <br/>
            <br/>
        ))}
    </section>
    <section class="news">
        <h3>In the news</h3>
        {about.news_coverage.map((n: NewsCoverage) => (
            <a href={n.href}>
                {n.title}
            </a>
            <br/>
            <br/>
        ))}
    </section>
</Layout>

<style>
    .meetup {
        display: flex;
        flex-direction: column;
        gap: 1em;
        padding-top: 2em;
    }

    .side-by-side {
        display: grid;

        p {
            font-size: 1.2em;
            margin: auto;
        }
    }

    @media (width > 700px) {
        .side-by-side {
            grid-template-columns: 1fr 1fr;
        }
    }

    section {
        &:not(:last-child) {
            padding-bottom: 2em;
        }

        &:not(:first-child) {
            padding-top: 1em;
        }
    }

    h2 {
        text-align: center;
    }

    .link-group {
        display: grid;
        grid-template-columns: 1fr 1fr;
        justify-content: center;
        gap: 1ch;

        a {
            display: flex;
            justify-content: start;
            align-items: center;
            gap: 1ch;
        }
    }

    .email {
        --color-bg: var(--color-orange);
    }

    .socials {
        --color-bg: var(--color-mauve);
    }

    .resources {
        h3 {
            margin-bottom: 1em;
        }
    }

    .news {
        h3 {
            margin-bottom: 1em;
        }
    }
</style>
