---
import EventButton from "../components/EventButton.astro";
import Layout from "../components/Layout.astro";
import { directus } from "../lib/directus";
import { readItems } from "@directus/sdk";
import { formatDate } from "../lib/format";

const now = new Date().toISOString();

const nextEvent = (
    await directus.request(
        readItems("events", {
            filter: {
                date: { _gte: now } as any,
            },
            sort: ["date"],
            limit: 1,
        }),
    )
)[0];
---

<Layout
    description=`Repair meetups in Portland, Maine, USA. The next event is ${formatDate(nextEvent.date)}`
>
    <section class="side-by-side">
        <p>
            A semi-regular hang to fix our broken things, learn new skills,
            teach each other stuff, and build community across social circles.
            Free & open to all.
        </p>
        <div class="meetup">
            <h2>Come to the next meetup!</h2>
            <EventButton event={nextEvent} />
            <a href="/events/"> View all events </a>
        </div>
    </section>
    <section>
        <a class="email" href="/signup/">
            <h2>Sign up for emails!</h2>
        </a>
    </section>
    <section>
        <a href="https://www.instagram.com/ripe_for_repair/">
            <h2>Instagram</h2>
        </a>

        <a href="https://www.facebook.com/p/Ripe-for-Repair-61556538260758/">
            <h2>Facebook</h2>
        </a>
    </section>
    <section>
        <h2>In the news</h2>
        <ul>
            <li>
                <a
                    href="https://www.pressherald.com/2024/12/09/portland-repair-meetups-mend-items-knit-community/"
                >
                    In The Forecaster
                </a>
            </li>
            <li>
                <a
                    href="https://wgme.com/news/local/mainers-unite-to-fix-items-and-build-skills-at-ripe-to-repair-event-in-portland"
                >
                    On TV (WGME)
                </a>
            </li>
        </ul>
    </section>
</Layout>

<style>
    .meetup {
        display: flex;
        flex-direction: column;
        gap: 1em;
        padding-top: 2em;
    }

    .side-by-side {
        display: grid;

        p {
            font-size: 1.2em;
            margin: auto;
        }
    }

    @media (width > 700px) {
        .side-by-side {
            grid-template-columns: 1fr 1fr;
        }
    }

    section {
        &:not(:last-child) {
            padding-bottom: 2em;
            border-bottom: 1px solid #ffffff;
        }

        &:not(:first-child) {
            padding-top: 1em;
        }
    }
</style>
