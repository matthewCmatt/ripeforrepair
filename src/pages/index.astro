---
import EventButton from "../components/EventButton.astro";
import Layout from "../components/Layout.astro";
import { directus } from "../lib/directus";
import { readItems } from "@directus/sdk";

const now = new Date().toISOString();

const nextEvent = (
    await directus.request(
        readItems("events", {
            filter: {
                date: { _gte: now } as any,
            },
            sort: ["date"],
            limit: 1,
        }),
    )
)[0];
---

<Layout
    description="Repair meetups in Portland, Maine, USA. The next event is "
>
    <main>
        <div class="side-by-side">
            <p>
                A semi-regular hang to fix our broken things, learn new skills,
                teach each other stuff, and build community across social
                circles. Free & open to all.
            </p>
            <section>
                <h2>Come to the next meetup!</h2>
                <EventButton event={nextEvent} />
                <a href="/events/"> View all events </a>
            </section>
        </div>
        <hr />
        <a href="/signup/">
            <h2>Sign up for emails!</h2>
        </a>
        <hr />
        <a href="https://www.instagram.com/ripe_for_repair/">
            <h2>Instagram</h2>
        </a>
        <hr />
        <h2>In the news</h2>
        <ul>
            <a
                href="https://www.pressherald.com/2024/12/09/portland-repair-meetups-mend-items-knit-community/"
            >
                <li>In The Forecaster</li>
            </a>
            <a
                href="https://wgme.com/news/local/mainers-unite-to-fix-items-and-build-skills-at-ripe-to-repair-event-in-portland"
            >
                <li>On TV (WGME)</li>
            </a>
        </ul>
    </main>
</Layout>

<style>
    body {
        padding: 1em;
        max-width: 80ch;
        margin: auto;
        background-color: var(--color-green);
    }

    h1 {
        text-align: center;
        padding: 0.5em 0;
        font-weight: 400;
        letter-spacing: -1px;
    }

    section {
        display: flex;
        flex-direction: column;
        gap: 1em;
        padding-top: 2em;
    }

    .side-by-side {
        display: grid;

        p {
            font-size: 1.2em;
            margin: auto;
        }
    }

    @media (width > 700px) {
        .side-by-side {
            grid-template-columns: 1fr 1fr;
        }
    }
</style>
